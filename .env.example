# Everyone signs in with their own Garmin Connect email + password — there
# are no dashboard passwords. Accounts live in users.json (no passwords in
# there either); people join via /signup with the invite code below, or you
# add them with `python manage_users.py add <garmin_email>`.

# Where the account store lives. Defaults to ./data/users.json if unset.
USERS_STORE=./data/users.json

# Where each user's activity review notes are stored. One shared SQLite
# file, rows scoped per username internally.
REVIEWS_DB=./data/reviews.db

# How long a fetched dashboard payload is reused before hitting Garmin again, in seconds.
DASHBOARD_CACHE_TTL=1200

HOST=127.0.0.1
# 5000 conflicts with macOS's AirPlay Receiver (System Settings > General >
# AirDrop & Handoff), which silently answers on that port with a 403 — use
# a different port, or disable AirPlay Receiver if you want to keep 5000.
PORT=5050

# --- Login (required before exposing this beyond localhost/LAN) ---
# Signs the login session cookie. `python manage_users.py init` generates
# it. If you set it by hand,
# use a long random value — anyone who has it can forge a logged-in session.
SESSION_SECRET=
# How many days a login stays valid before you have to sign in again.
SESSION_LIFETIME_DAYS=30
# Only send the session cookie over HTTPS. Leave false for plain-HTTP local/
# LAN use; set true once there's a real TLS certificate in front of this
# (e.g. a Caddy/nginx reverse proxy, or Cloudflare Tunnel) — see README
# before exposing this beyond your LAN.
SESSION_COOKIE_SECURE=false

# --- Self-service signup (optional) ---
# Set this to let people create their own account at /signup by signing in
# with their own Garmin credentials. Share the code privately (text, not the
# app) with whoever you're inviting — leave unset to disable signup
# entirely and only add people yourself via `manage_users.py add`.
SIGNUP_INVITE_CODE=

# --- MCP server (optional) ---
# Runs as a separate process (mcp_server.py) so a Claude chat can read
# your live dashboard data and push a coaching note back to it. Needs its
# own public HTTPS hostname distinct from the main site — e.g. a
# "mcp." subdomain routed to MCP_PORT via the same Cloudflare Tunnel /
# reverse proxy setup as the main app. Leave MCP_PUBLIC_URL unset if you
# don't want to run this.
MCP_PUBLIC_URL=
MCP_HOST=127.0.0.1
MCP_PORT=5052
# How long a pushed coach note stays "active" on the dashboard before the
# auto-generated suggestion takes back over.
COACH_NOTE_FRESHNESS_HOURS=48
